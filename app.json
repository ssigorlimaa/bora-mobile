{
  "expo": {
    "name": "BORA",
    "slug": "bora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "bora",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bora.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O BORA usa sua localização aproximada para encontrar corridas perto de você."
      }
    },
    "android": {
      "package": "com.bora.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0885ad42-13ab-419e-b252-33c28491a547"
      }
    }
  }
}
